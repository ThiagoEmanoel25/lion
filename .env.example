NODE_ENV=development
API_PORT=3333
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://nexo:nexo@localhost:5432/nexo?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-characters
FIELD_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# Gere em produção com: openssl rand -base64 32
# Usada para credenciais e chaves Signal do Baileys. Troca exige rotação/migração dos dados.
WHATSAPP_PROVIDER=baileys
WHATSAPP_PROVIDER=baileys
WHATSAPP_CONNECT_CONCURRENCY=4
WHATSAPP_MESSAGE_CONCURRENCY=20
WHATSAPP_SESSION_LOCK_TTL_MS=30000
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
