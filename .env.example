NODE_ENV=development
API_PORT=3333
WEB_ORIGIN=http://localhost:5173
# Origem pública HTTPS da API, embutida no favorito de importação da Leona.
PUBLIC_API_URL=http://localhost:3333
DATABASE_URL=postgresql://nexo:nexo@localhost:5432/nexo?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-characters
FIELD_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# Gere em produção com: openssl rand -base64 32
# Usada para credenciais e chaves Signal do Baileys. Troca exige rotação/migração dos dados.
WHATSAPP_PROVIDER=baileys
WHATSAPP_CONNECT_CONCURRENCY=4
WHATSAPP_MESSAGE_CONCURRENCY=20
WHATSAPP_SESSION_LOCK_TTL_MS=30000
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
# não usado no piloto (pagamento desligado, decisão 2026-11-23)
STRIPE_SECRET_KEY=

# Rate limit / lockout de login, refresh e aceite de convite (por IP; lockout por e-mail)
LOGIN_RATE_MAX=20
LOGIN_RATE_WINDOW_SEC=60
LOGIN_LOCKOUT_MAX_FAILS=5
LOGIN_LOCKOUT_WINDOW_SEC=900
LOGIN_LOCKOUT_SEC=900
REFRESH_RATE_MAX=30
REFRESH_RATE_WINDOW_SEC=60
INVITE_RATE_MAX=10
INVITE_RATE_WINDOW_SEC=60
# IP real atrás do Nginx: em produção o default é "loopback" (Nginx no mesmo host). Use false/true/lista de CIDRs se diferente.
# TRUST_PROXY=loopback
