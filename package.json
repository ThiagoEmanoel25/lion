{
  "name": "nexo-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n api,runtime,web -c green,yellow,cyan \"npm run dev -w @nexo/api\" \"npm run dev -w @nexo/runtime\" \"npm run dev -w @nexo/web\"",
    "dev:api": "npm run dev -w @nexo/api",
    "dev:web": "npm run dev -w @nexo/web",
    "dev:runtime": "npm run dev -w @nexo/runtime",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:seed": "npm run db:seed -w @nexo/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "fast-jwt": "^6.3.4",
    "deepmerge-ts": "^8.0.0"
  },
  "engines": {"node": ">=22"}
}
