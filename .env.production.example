# Modelo SEM segredos. No servidor: copie para .env e preencha. chmod 600 .env
NODE_ENV=production
API_PORT=3333
# Obrigatório em produção (https; lista separada por vírgula permitida). Sem fallback para localhost.
WEB_ORIGIN=https://nexo.example.com
# Obrigatório em produção (https)
PUBLIC_API_URL=https://nexo.example.com/api
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/nexo?schema=public
REDIS_URL=redis://127.0.0.1:6379
# openssl rand -base64 48
JWT_SECRET=
# Em produção a API e o runtime recusam subir (exit 1) se DATABASE_URL/REDIS_URL/JWT_SECRET(>=32)/FIELD_ENCRYPTION_KEY(base64, 32 bytes)/WEB_ORIGIN/PUBLIC_API_URL faltarem ou forem placeholders.
# Seed recusa NODE_ENV=production sem ALLOW_SEED_IN_PRODUCTION=1.
# openssl rand -base64 32  (não trocar depois sem migrar dados cifrados)
FIELD_ENCRYPTION_KEY=
WHATSAPP_PROVIDER=baileys
WHATSAPP_CONNECT_CONCURRENCY=4
WHATSAPP_MESSAGE_CONCURRENCY=20
WHATSAPP_SESSION_LOCK_TTL_MS=30000
LOG_LEVEL=info
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
# não usado no piloto (pagamento desligado, decisão 2026-11-23)
STRIPE_SECRET_KEY=

# Rate limit / lockout de login, refresh e aceite de convite (por IP; lockout por e-mail)
LOGIN_RATE_MAX=20
LOGIN_RATE_WINDOW_SEC=60
LOGIN_LOCKOUT_MAX_FAILS=5
LOGIN_LOCKOUT_WINDOW_SEC=900
LOGIN_LOCKOUT_SEC=900
REFRESH_RATE_MAX=30
REFRESH_RATE_WINDOW_SEC=60
INVITE_RATE_MAX=10
INVITE_RATE_WINDOW_SEC=60
# IP real atrás do Nginx: em produção o default é "loopback" (Nginx no mesmo host). Use false/true/lista de CIDRs se diferente.
# TRUST_PROXY=loopback
